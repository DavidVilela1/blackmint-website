# ─────────────────────────────────────────────────────────────────────────────
# BlackMint Interactive — environment variables
# Copy to `.env.local` for local development. NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical public origin, no trailing slash. Used for canonical URLs, hreflang,
# the sitemap, robots.txt, Open Graph and llms.txt.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Deployment environment: "production" enables indexing. Any other value
# (e.g. "staging", "preview", "development") makes robots.txt disallow all
# crawling and adds <meta name="robots" content="noindex"> to every page.
NEXT_PUBLIC_SITE_ENV=development

# Public studio contact address shown in the footer / contact page.
# Leave empty until a real, monitored address exists.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Contact form delivery (server-only; never prefix with NEXT_PUBLIC_) ──────
# Provider: "resend" | "webhook" | "" (empty = form is shown as NOT connected)
CONTACT_PROVIDER=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=
# Verified sender identity at your provider, e.g. "BlackMint Website <web@yourdomain>".
CONTACT_FROM_EMAIL=
# Resend API key (https://resend.com) — required when CONTACT_PROVIDER=resend.
RESEND_API_KEY=
# HTTPS endpoint that receives a JSON POST — required when CONTACT_PROVIDER=webhook.
CONTACT_WEBHOOK_URL=
# Optional shared secret sent as the "X-Webhook-Secret" header to the webhook.
CONTACT_WEBHOOK_SECRET=

# Placeholder games/journal entries are noindex by default. Set to "true" only
# once they have been replaced with real, approved content.
INDEX_PLACEHOLDER_CONTENT=false
